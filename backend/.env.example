# Copy to backend/.env (git-ignored) and fill in. Never commit real keys.

# Which LLM to use: mock (offline rule-based baseline) | claude_foundry | azure_openai
OTD_LLM_PROVIDER=mock

# --- Claude in Microsoft Foundry (resource: csc-blp-foundry-cus, Central US, resource group AI-F-rg-csc-blp, Hackathon 5.0 EA Subscription) ---
ANTHROPIC_FOUNDRY_RESOURCE=csc-blp-foundry-cus
ANTHROPIC_FOUNDRY_API_KEY=
OTD_CLAUDE_FAST_MODEL=claude-haiku-5-5
OTD_CLAUDE_SMART_MODEL=claude-sonnet-5-5

# --- Azure OpenAI fallback (same Foundry resource, v1 endpoint) ---
OTD_AOAI_BASE_URL=https://csc-blp-foundry-cus.openai.azure.com/openai/v1
OTD_AOAI_API_KEY=
OTD_AOAI_FAST_DEPLOYMENT=gpt-4.1-mini
OTD_AOAI_SMART_DEPLOYMENT=gpt-4.1

# Optional: JSONL log of every LLM call (prompt version, model, tokens, latency)
OTD_LLM_LOG_FILE=logs/llm_calls.jsonl
