server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # API calls go to the FastAPI container (API_URL set by docker compose or Container Apps)
  location /api/ {
    proxy_pass ${API_URL};
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
    proxy_read_timeout 120s;  # an evidence answer with one repair round can take ~30s; eval runs are background jobs
  }

  location / {
    try_files $uri /index.html;
  }
}
